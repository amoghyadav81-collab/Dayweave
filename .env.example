# Copy to .env.local for development; use secure host environment settings in production.
APP_URL=http://localhost:3000
# Absolute path recommended. Production must use a persistent disk, e.g. /data/dayweave.sqlite.
DATABASE_PATH=./data/dayweave.sqlite
# Set a long, randomly generated value privately. Blank disables new account registration.
SIGNUP_INVITE_CODE=
# Exact callback URIs only. Confirm the callback shown by your ChatGPT client.
OAUTH_REDIRECT_URIS=["https://chatgpt.com/connector_platform/oauth_redirect"]
NEXT_TELEMETRY_DISABLED=1
# 2.1 adds no scheduler credentials or new infrastructure. Recurring execution is not enabled.
# AI write controls (operationId/expectedVersion) are request fields, not environment variables.
