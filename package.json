{
  "name": "dayweave",
  "version": "2.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "tsc --noEmit",
    "test:browser": "playwright test",
    "release": "npm run check && npm test && npm run build && node scripts/release.mjs",
    "deploy:check": "node scripts/check-deployment.mjs",
    "start:host": "node --env-file-if-exists=.env.local scripts/start-host.mjs",
    "test:container": "node scripts/test-container.mjs",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@js-temporal/polyfill": "0.5.1",
    "@node-oauth/oauth2-server": "5.3.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.3.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "5.9.3"
  },
  "type": "module"
}
